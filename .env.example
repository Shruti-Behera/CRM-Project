# Copy this file to ".env" (same folder) and fill in real values.
#   cp .env.example .env

# Database password (used by both Postgres and the app connection string)
DB_PASSWORD=change-me-to-a-strong-password

# JWT signing secret — 60+ random characters. Generate one, don't type it:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
