# =====================================================================
#  Ashika WDM — environment configuration template.
#  Copy this file to "Server/.env" and fill in real values:
#      cp Server/.env.example Server/.env
#  The real .env is git-ignored and must NEVER be committed.
#
#  Same application code runs everywhere — only these values change:
#    * Local machine  -> your local PostgreSQL (fill in below).
#    * Ubuntu / live   -> set these as real environment variables on the
#                         server (systemd unit, Docker env, or export);
#                         real env vars automatically override this file.
# =====================================================================

# --- Database (individual parts — the recommended form) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ashika_wdm
DB_USER=postgres
DB_PASSWORD=change-me
DB_POOL_MAX=10
# DB_SSLMODE=Require        # Require/Prefer/Disable — use Require for managed/remote DBs

# --- Database (alternative: one full connection string instead of the parts) ---
# ConnectionStrings__Db=Host=localhost;Port=5432;Database=ashika_wdm;Username=postgres;Password=change-me;Maximum Pool Size=10

# --- Other secrets (optional here; on the server set them as env vars) ---
# JWT signing secret (60+ random chars):  openssl rand -base64 48
# Jwt__Secret=change-me-generate-with-openssl-rand-base64-48
# Smtp__Password=your-smtp-password
